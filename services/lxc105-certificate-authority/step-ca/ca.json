{
	"root": "/root/.step/certs/root_ca.crt",
	"federatedRoots": null,
	"crt": "/root/.step/certs/intermediate_ca.crt",
	"key": "<redacted>",
	"address": ":8443",
	"insecureAddress": "",
	"dnsNames": [
		"ca.example.home",
		"<lan-ip>"
	],
	"logger": {
		"format": "text"
	},
	"db": {
		"type": "badgerv2",
		"dataSource": "/root/.step/db",
		"badgerFileLoadingMode": ""
	},
	"authority": {
		"provisioners": [
			{
				"type": "JWK",
				"name": "<user>",
				"key": {
					"use": "sig",
					"kty": "EC",
					"kid": "<redacted>",
					"crv": "P-256",
					"alg": "ES256",
					"x": "<redacted>",
					"y": "<redacted>"
				},
				"encryptedKey": "<redacted>",
				"claims": {
					"maxTLSCertDuration": "19920h0m0s",
					"defaultTLSCertDuration": "19920h0m0s",
					"enableSSHCA": false,
					"disableRenewal": false,
					"allowRenewalAfterExpiry": false,
					"disableSmallstepExtensions": false
				},
				"options": {
					"x509": {},
					"ssh": {}
				}
			},
			{
				"type": "ACME",
				"name": "acme",
				"claims": {
					"enableSSHCA": true,
					"disableRenewal": false,
					"allowRenewalAfterExpiry": false,
					"disableSmallstepExtensions": false
				},
				"options": {
					"x509": {},
					"ssh": {}
				}
			}
		],
		"template": {},
		"backdate": "1m0s"
	},
	"tls": {
		"cipherSuites": [
			"<redacted>",
			"<redacted>"
		],
		"minVersion": 1.2,
		"maxVersion": 1.3,
		"renegotiation": false
	},
	"commonName": "Step Online CA"
}
